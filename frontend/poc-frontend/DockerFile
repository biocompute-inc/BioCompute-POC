FROM node:20-alpine

WORKDIR /app

# Install dependencies first for better caching
COPY package.json package-lock.json ./
RUN npm install

# Copy the rest of the frontend code
COPY . .

EXPOSE 3000

# Run in development mode
CMD ["npm", "run", "dev"]
# frontend/poc-frontend/Dockerfile
FROM node:20-alpine

WORKDIR /app

# Install dependencies first for better caching
COPY package.json package-lock.json ./
RUN npm install

# Copy the rest of the frontend code
COPY . .

# Switch out of the 'root' user into the 'node' user
USER node

EXPOSE 3000

# Run in development mode
CMD ["npm", "run", "dev"]